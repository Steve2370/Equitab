<mjml>
  <mj-head>
    <mj-font name="Montserrat" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" />
    <mj-attributes>
      <mj-all font-family="Montserrat, Arial, sans-serif" />
      <mj-text font-size="15px" line-height="1.6" color="#374151" />
    </mj-attributes>
  </mj-head>

  <mj-body background-color="#F9FAFB">

    <!-- Header -->
    <mj-section background-color="#0B1929" padding="24px 32px">
      <mj-column>
        <mj-column>
            <mj-image src="https://equitab.ca/Images/EquitabLogoblanc.png" alt="Equitab" width="170px" align="center" padding="0" />
        </mj-column>
      </mj-column>
    </mj-section>

    <!-- Hero -->
    <mj-section background-color="#FFFFFF" padding="40px 32px 24px">
      <mj-column>
        <mj-text font-size="28px" font-weight="700" color="#0B1929" align="center">
          Nouveau message
        </mj-text>
        <mj-text align="center" color="#6B7280" padding-top="8px">
          Bonjour <strong>{{ $recipientName }}</strong>, vous avez reçu un message sur Equitab.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Message -->
    <mj-section background-color="#FFFFFF" padding="0 32px 24px">
      <mj-column background-color="#F8FAFC" border-radius="12px" padding="24px" border-left="4px solid #10B981">
        <mj-text font-size="13px" color="#6B7280" padding-bottom="8px">
          <strong>{{ $senderName }}</strong> dans le groupe <strong>{{ $groupName }}</strong>
        </mj-text>
        <mj-text font-size="15px" color="#374151" font-style="italic">
          "{{ $messagePreview }}"
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- CTA -->
    <mj-section background-color="#FFFFFF" padding="0 32px 40px">
      <mj-column>
        <mj-button href="{{ $chatUrl }}" background-color="#10B981" color="#FFFFFF" font-size="15px" font-weight="600" border-radius="8px" padding="14px 0" inner-padding="14px 48px" width="100%">
          Répondre au message
        </mj-button>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section background-color="#F3F4F6" padding="24px 32px">
      <mj-column>
        <mj-text font-size="12px" color="#9CA3AF" align="center">
          © 2026 Equitab Inc. — Plateforme de partage d'abonnements
        </mj-text>
        <mj-text font-size="12px" color="#9CA3AF" align="center" padding-top="4px">
          Vous recevez cet email car vous avez activé les notifications de messages.
          <a href="{{ config('app.url') }}/dashboard/preferences" style="color: #10B981;">Gérer mes préférences</a>
        </mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>

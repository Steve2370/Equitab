<mjml lang="fr">
  <mj-head><mj-include path="./partials/head.mjml" /><mj-preview>Un nouveau message vous attend dans votre espace EquitAb.</mj-preview></mj-head>
  <mj-body background-color="#f6f8f6" width="600px">
    <mj-include path="./partials/header.mjml" />
    <mj-wrapper background-color="#ffffff" border="1px solid #dce5df" border-radius="24px" padding="32px 0" css-class="email-card">
      <mj-section css-class="email-section"><mj-column>
        <mj-text mj-class="eyebrow">VOTRE CONVERSATION</mj-text>
        <mj-text mj-class="headline" css-class="email-copy"><h1>On vous a écrit.</h1></mj-text>
        <mj-text css-class="email-copy">Bonjour <strong>{{ $recipientName }}</strong>, un nouveau message vous attend.</mj-text>
      </mj-column></mj-section>
      <mj-section padding-bottom="24px" css-class="email-section"><mj-column mj-class="details">
<mj-text font-weight="600" padding="0 0 4px" css-class="email-copy">{{ $senderName }}</mj-text>
<mj-text mj-class="note" css-class="email-copy">À propos de {{ $groupName }}</mj-text>
<mj-text padding="0" css-class="email-copy">« {{ $messagePreview }} »</mj-text>
      </mj-column></mj-section>
      <mj-section css-class="email-section"><mj-column>
        <mj-button href="{{ $chatUrl }}">Lire et répondre</mj-button>        <mj-text mj-class="note" padding="20px 0 0">Poursuivez la conversation dans votre espace EquitAb.</mj-text>
      </mj-column></mj-section>
    </mj-wrapper>
    <mj-include path="./partials/footer.mjml" />
  </mj-body>
</mjml>

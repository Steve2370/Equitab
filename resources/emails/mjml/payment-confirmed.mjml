<mjml>
  <mj-head>
    <mj-font name="Montserrat" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" />
    <mj-attributes>
      <mj-all font-family="Montserrat, Arial, sans-serif" />
      <mj-text font-size="15px" line-height="1.6" color="#374151" />
    </mj-attributes>
    <mj-style>
      .btn-primary { background: #10B981 !important; }
    </mj-style>
  </mj-head>

  <mj-body background-color="#F9FAFB">

    <!-- Header -->
    <mj-section background-color="#0B1929" padding="24px 32px">
      <mj-column>
        <mj-column>
            <mj-image src="https://equitab.ca/Images/EquitabLogoblanc.png" alt="Equitab" width="170px" align="center" padding="0" />
        </mj-column>
      </mj-column>
    </mj-section>

    <!-- Hero -->
    <mj-section background-color="#FFFFFF" padding="40px 32px 24px">
      <mj-column>
        <mj-text font-size="28px" font-weight="700" color="#0B1929" align="center">
          Paiement confirmé
        </mj-text>
        <mj-text align="center" color="#6B7280" padding-top="8px">
          Bonjour <strong>{{ $memberName }}</strong>, votre abonnement est actif.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Détails paiement -->
    <mj-section background-color="#FFFFFF" padding="0 32px 24px">
      <mj-column background-color="#F0FDF4" border-radius="12px" padding="24px">
        <mj-text font-size="14px" color="#6B7280" padding-bottom="4px">
          ABONNEMENT
        </mj-text>
        <mj-text font-size="18px" font-weight="600" color="#0B1929" padding-top="0">
          {{ $groupName }}
        </mj-text>
        <mj-divider border-color="#D1FAE5" border-width="1px" padding="12px 0" />
        <mj-table>
          <tr>
            <td style="padding: 4px 0; color: #6B7280; font-size: 14px;">Montant débité</td>
            <td style="padding: 4px 0; color: #0B1929; font-weight: 600; text-align: right;">{{ $amount }} $ CAD</td>
          </tr>
          <tr>
            <td style="padding: 4px 0; color: #6B7280; font-size: 14px;">Service</td>
            <td style="padding: 4px 0; color: #0B1929; font-weight: 600; text-align: right;">{{ $subscriptionName }}</td>
          </tr>
          <tr>
            <td style="padding: 4px 0; color: #6B7280; font-size: 14px;">Prochain renouvellement</td>
            <td style="padding: 4px 0; color: #0B1929; font-weight: 600; text-align: right;">{{ $nextBillingDate }}</td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <!-- Identifiants -->
    <mj-section background-color="#FFFFFF" padding="0 32px 32px">
      <mj-column background-color="#EFF6FF" border-radius="12px" padding="20px">
        <mj-text font-size="14px" color="#1D4ED8" font-weight="600">
          🔑 Accédez à vos identifiants
        </mj-text>
        <mj-text font-size="14px" color="#1E40AF" padding-top="4px">
          Vos identifiants de connexion sont disponibles dans votre tableau de bord Equitab, dans la section "Abonnements rejoints".
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- CTA -->
    <mj-section background-color="#FFFFFF" padding="0 32px 40px">
      <mj-column>
        <mj-button href="{{ $dashboardUrl }}" background-color="#10B981" color="#FFFFFF" font-size="15px" font-weight="600" border-radius="8px" padding="14px 0" inner-padding="14px 48px" width="100%">
            Accéder à mon espace
        </mj-button>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section background-color="#F3F4F6" padding="24px 32px">
      <mj-column>
        <mj-text font-size="12px" color="#9CA3AF" align="center">
          © 2026 Equitab Inc. — Plateforme de partage d'abonnements
        </mj-text>
        <mj-text font-size="12px" color="#9CA3AF" align="center" padding-top="4px">
          Si vous n'êtes pas à l'origine de ce paiement, contactez-nous à
          <a href="mailto:support@equitab.ca" style="color: #10B981;">support@equitab.ca</a>
        </mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>

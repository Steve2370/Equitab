<mjml lang="fr">
  <mj-head><mj-include path="./partials/head.mjml" /><mj-preview>Votre part a été mise à jour. Consultez le montant de votre prochain renouvellement.</mj-preview></mj-head>
  <mj-body background-color="#f6f8f6" width="600px">
    <mj-include path="./partials/header.mjml" />
    <mj-wrapper background-color="#ffffff" border="1px solid #dce5df" border-radius="24px" padding="32px 0" css-class="email-card">
      <mj-section css-class="email-section"><mj-column>
        <mj-text mj-class="eyebrow">VOTRE PART MENSUELLE</mj-text>
        <mj-text mj-class="headline" css-class="email-copy"><h1>{{ $isDecrease ? 'Votre part diminue.' : 'Votre part a changé.' }}</h1></mj-text>
        <mj-text css-class="email-copy">Bonjour <strong>{{ $memberName }}</strong>, le montant de votre participation au groupe a été mis à jour.</mj-text>
      </mj-column></mj-section>
      <mj-section padding-bottom="24px" css-class="email-section"><mj-column mj-class="details">
        <mj-table css-class="details-table">
          <tr><td>Service</td><td>{{ $subscriptionName }}</td></tr>
          <tr><td>Groupe</td><td>{{ $groupName }}</td></tr>
          <tr><td>Ancienne part</td><td>{{ $displayOldPrice }}</td></tr>
          <tr><td>Nouvelle part</td><td>{{ $displayNewPrice }}</td></tr>
        </mj-table>
      </mj-column></mj-section>
      <mj-section css-class="email-section"><mj-column>
<mj-text font-weight="600" padding="0 0 6px">Pourquoi ce changement ?</mj-text>
<mj-text font-size="14px">{{ $isDecrease ? 'De nouveaux membres ont rejoint le groupe, ce qui réduit la part de chacun.' : 'Un membre a quitté le groupe, ce qui augmente la part des membres restants.' }} Ce nouveau prix s’applique à votre prochain renouvellement.</mj-text>        <mj-button href="{{ $dashboardUrl }}">Consulter mes abonnements</mj-button>
      </mj-column></mj-section>
    </mj-wrapper>
    <mj-include path="./partials/footer.mjml" />
  </mj-body>
</mjml>

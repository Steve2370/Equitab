<mjml lang="fr">
  <mj-head><mj-include path="./partials/head.mjml" /><mj-preview>Votre groupe accueille un membre. Retrouvez les détails dans votre espace.</mj-preview></mj-head>
  <mj-body background-color="#f6f8f6" width="600px">
    <mj-include path="./partials/header.mjml" />
    <mj-wrapper background-color="#ffffff" border="1px solid #dce5df" border-radius="24px" padding="32px 0" css-class="email-card">
      <mj-section css-class="email-section"><mj-column>
        <mj-text mj-class="eyebrow">VOTRE GROUPE</mj-text>
        <mj-text mj-class="headline" css-class="email-copy"><h1>Une nouvelle personne vous rejoint.</h1></mj-text>
        <mj-text css-class="email-copy">Bonjour <strong>{{ $ownerName }}</strong>, <strong>{{ $memberName }}</strong> a rejoint votre groupe. Retrouvez les informations utiles ci-dessous.</mj-text>
      </mj-column></mj-section>
      <mj-section padding-bottom="24px" css-class="email-section"><mj-column mj-class="details">
        <mj-table css-class="details-table">
          <tr><td>Groupe</td><td>{{ $groupName }}</td></tr>
          <tr><td>Service</td><td>{{ $subscriptionName }}</td></tr>
          <tr><td>Contribution du membre</td><td>{{ $pricePerMember }}</td></tr>
          <tr><td>Places restantes</td><td>{{ $spotsLeft }}</td></tr>
        </mj-table>
      </mj-column></mj-section>
      <mj-section css-class="email-section"><mj-column>
<mj-text font-weight="600" padding="0 0 6px">Pensez aux informations d’accès</mj-text>
<mj-text font-size="14px">Assurez-vous que les identifiants du service sont renseignés dans votre groupe. Le membre doit pouvoir y accéder dans les 48 heures suivant son paiement.</mj-text>        <mj-button href="{{ $dashboardUrl }}">Gérer mon groupe</mj-button>
      </mj-column></mj-section>
    </mj-wrapper>
    <mj-include path="./partials/footer.mjml" />
  </mj-body>
</mjml>

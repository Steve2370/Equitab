<mjml>
  <mj-head>
    <mj-font name="Montserrat" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" />
    <mj-attributes>
      <mj-all font-family="Montserrat, Arial, sans-serif" />
      <mj-text font-size="15px" line-height="1.6" color="#374151" />
    </mj-attributes>
  </mj-head>

  <mj-body background-color="#F9FAFB">

    <mj-section background-color="#0B1929" padding="24px 32px">
      <mj-column>
        <mj-column>
            <mj-image src="https://equitab.ca/Images/EquitabLogoblanc.png" alt="Equitab" width="170px" align="center" padding="0" />
        </mj-column>
      </mj-column>
    </mj-section>

    <mj-section background-color="#FFFFFF" padding="40px 32px 24px">
      <mj-column>
        <mj-text font-size="28px" font-weight="700" color="#0B1929" align="center">
          Identité vérifiée
        </mj-text>
        <mj-text align="center" color="#6B7280" padding-top="8px">
          Bonjour <strong>{{ $userName }}</strong>, votre identité a été confirmée avec succès par Stripe Identity.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#FFFFFF" padding="0 32px 24px">
      <mj-column background-color="#F0FDF4" border-radius="12px" padding="24px">
        <mj-text font-size="15px" font-weight="600" color="#0B1929" padding-bottom="12px">
          Ce que vous pouvez faire maintenant :
        </mj-text>
        <mj-table>
            <tr>
                <td style="padding: 6px 0; color: #374151; font-size: 14px; vertical-align: middle;">
                <span style="display: inline-block; width: 16px; height: 16px; background: #10B981; border-radius: 50%; text-align: center; line-height: 16px; margin-right: 8px;">
                    <img src="https://cdn.jsdelivr.net/npm/lucide-static@0.383.0/icons/check.svg" width="10" height="10" style="filter: brightness(0) invert(1); vertical-align: middle;" />
                </span>
                Créer des groupes de partage
                </td>
            </tr>
            <tr>
                <td style="padding: 6px 0; color: #374151; font-size: 14px; vertical-align: middle;">
                <span style="display: inline-block; width: 16px; height: 16px; background: #10B981; border-radius: 50%; text-align: center; line-height: 16px; margin-right: 8px;">
                    <img src="https://cdn.jsdelivr.net/npm/lucide-static@0.383.0/icons/check.svg" width="10" height="10" style="filter: brightness(0) invert(1); vertical-align: middle;" />
                </span>
                Configurer votre compte bancaire
                </td>
            </tr>
            <tr>
                <td style="padding: 6px 0; color: #374151; font-size: 14px; vertical-align: middle;">
                <span style="display: inline-block; width: 16px; height: 16px; background: #10B981; border-radius: 50%; text-align: center; line-height: 16px; margin-right: 8px;">
                    <img src="https://cdn.jsdelivr.net/npm/lucide-static@0.383.0/icons/check.svg" width="10" height="10" style="filter: brightness(0) invert(1); vertical-align: middle;" />
                </span>
                Recevoir des paiements de vos membres
                </td>
            </tr>
            <tr>
                <td style="padding: 6px 0; color: #374151; font-size: 14px; vertical-align: middle;">
                <span style="display: inline-block; width: 16px; height: 16px; background: #10B981; border-radius: 50%; text-align: center; line-height: 16px; margin-right: 8px;">
                    <img src="https://cdn.jsdelivr.net/npm/lucide-static@0.383.0/icons/check.svg" width="10" height="10" style="filter: brightness(0) invert(1); vertical-align: middle;" />
                </span>
                Augmenter votre score de confiance
                </td>
            </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <mj-section background-color="#FFFFFF" padding="0 32px 24px">
      <mj-column background-color="#EFF6FF" border-radius="12px" padding="20px">
        <mj-text font-size="14px" color="#1D4ED8" font-weight="600">
          Prochaine étape
        </mj-text>
        <mj-text font-size="14px" color="#1E40AF" padding-top="4px">
          Pour commencer à partager vos abonnements, configurez votre compte bancaire via Stripe Connect depuis votre profil.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#FFFFFF" padding="0 32px 40px">
      <mj-column>
        <mj-button href="{{ $dashboardUrl }}" background-color="#10B981" color="#FFFFFF" font-size="15px" font-weight="600" border-radius="8px" padding="14px 0" inner-padding="14px 48px" width="100%">
          Accéder à mon profil
        </mj-button>
      </mj-column>
    </mj-section>

    <mj-section background-color="#F3F4F6" padding="24px 32px">
      <mj-column>
        <mj-text font-size="12px" color="#9CA3AF" align="center">
          © 2026 Equitab Inc. — Plateforme de partage d'abonnements
        </mj-text>
        <mj-text font-size="12px" color="#9CA3AF" align="center" padding-top="4px">
          Des questions ? <a href="mailto:support@equitab.ca" style="color: #10B981;">support@equitab.ca</a>
        </mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>

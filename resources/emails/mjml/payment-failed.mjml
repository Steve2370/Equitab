<mjml>
  <mj-head>
    <mj-font name="Montserrat" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" />
    <mj-attributes>
      <mj-all font-family="Montserrat, Arial, sans-serif" />
      <mj-text font-size="15px" line-height="1.6" color="#374151" />
    </mj-attributes>
  </mj-head>

  <mj-body background-color="#F9FAFB">

    <!-- Header -->
    <mj-section background-color="#0B1929" padding="24px 32px">
      <mj-column>
        <mj-text font-size="22px" font-weight="700" color="#FFFFFF" align="center">
          Equitab
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Hero -->
    <mj-section background-color="#FFFFFF" padding="40px 32px 24px">
      <mj-column>
        <mj-text font-size="28px" font-weight="700" color="#DC2626" align="center">
          Échec de paiement 
        </mj-text>
        <mj-text align="center" color="#6B7280" padding-top="8px">
          Bonjour <strong>{{ $memberName }}</strong>, votre paiement n'a pas pu être traité.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Détails -->
    <mj-section background-color="#FFFFFF" padding="0 32px 24px">
      <mj-column background-color="#FEF2F2" border-radius="12px" padding="24px">
        <mj-table>
          <tr>
            <td style="padding: 6px 0; color: #6B7280; font-size: 14px;">Service</td>
            <td style="padding: 6px 0; color: #0B1929; font-weight: 600; text-align: right;">{{ $subscriptionName }}</td>
          </tr>
          <tr>
            <td style="padding: 6px 0; color: #6B7280; font-size: 14px;">Groupe</td>
            <td style="padding: 6px 0; color: #0B1929; font-weight: 600; text-align: right;">{{ $groupName }}</td>
          </tr>
          <tr>
            <td style="padding: 6px 0; color: #6B7280; font-size: 14px;">Montant</td>
            <td style="padding: 6px 0; color: #DC2626; font-weight: 700; text-align: right;">{{ $amount }} $ CAD</td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <!-- Raisons possibles -->
    <mj-section background-color="#FFFFFF" padding="0 32px 24px">
      <mj-column>
        <mj-text font-size="15px" font-weight="600" color="#0B1929" padding-bottom="12px">
          Raisons possibles :
        </mj-text>
        <mj-table>
          <tr>
            <td style="padding: 6px 0; color: #374151; font-size: 14px;">• Fonds insuffisants sur votre carte</td>
          </tr>
          <tr>
            <td style="padding: 6px 0; color: #374151; font-size: 14px;">• Carte expirée ou bloquée</td>
          </tr>
          <tr>
            <td style="padding: 6px 0; color: #374151; font-size: 14px;">• Limite de transaction dépassée</td>
          </tr>
          <tr>
            <td style="padding: 6px 0; color: #374151; font-size: 14px;">• Paiement refusé par votre banque</td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <!-- Avertissement -->
    <mj-section background-color="#FFFFFF" padding="0 32px 24px">
      <mj-column background-color="#FFF7ED" border-radius="12px" padding="20px">
        <mj-text font-size="14px" color="#C2410C" font-weight="600">
          ⚠️ Accès suspendu
        </mj-text>
        <mj-text font-size="14px" color="#9A3412" padding-top="4px">
          Votre accès au groupe <strong>{{ $groupName }}</strong> a été suspendu jusqu'au règlement du paiement. Mettez à jour votre moyen de paiement depuis votre tableau de bord.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- CTA -->
    <mj-section background-color="#FFFFFF" padding="0 32px 16px">
      <mj-column>
        <mj-button href="{{ $dashboardUrl }}" background-color="#DC2626" color="#FFFFFF" font-size="15px" font-weight="600" border-radius="8px" padding="14px 0" inner-padding="14px 48px" width="100%">
          Mettre à jour mon paiement
        </mj-button>
      </mj-column>
    </mj-section>

    <mj-section background-color="#FFFFFF" padding="0 32px 40px">
      <mj-column>
        <mj-text font-size="13px" color="#6B7280" align="center">
          Besoin d'aide ? <a href="{{ $supportUrl }}" style="color: #10B981;">Contactez notre support</a>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section background-color="#F3F4F6" padding="24px 32px">
      <mj-column>
        <mj-text font-size="12px" color="#9CA3AF" align="center">
          © 2026 Equitab Inc. — Plateforme de partage d'abonnements
        </mj-text>
        <mj-text font-size="12px" color="#9CA3AF" align="center" padding-top="4px">
          Des questions ? <a href="mailto:support@equitab.ca" style="color: #10B981;">support@equitab.ca</a>
        </mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>

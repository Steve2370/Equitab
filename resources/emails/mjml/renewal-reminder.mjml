<mjml lang="fr">
  <mj-head><mj-include path="./partials/head.mjml" /><mj-preview>Votre renouvellement approche. Retrouvez la date et le montant prévus.</mj-preview></mj-head>
  <mj-body background-color="#f6f8f6" width="600px">
    <mj-include path="./partials/header.mjml" />
    <mj-wrapper background-color="#ffffff" border="1px solid #dce5df" border-radius="24px" padding="32px 0" css-class="email-card">
      <mj-section css-class="email-section"><mj-column>
        <mj-text mj-class="eyebrow">VOTRE PROCHAINE ÉCHÉANCE</mj-text>
        <mj-text mj-class="headline" css-class="email-copy"><h1>Votre abonnement se renouvelle dans 3 jours.</h1></mj-text>
        <mj-text css-class="email-copy">Bonjour <strong>{{ $memberName }}</strong>, voici le récapitulatif de votre prochain renouvellement automatique.</mj-text>
      </mj-column></mj-section>
      <mj-section padding-bottom="24px" css-class="email-section"><mj-column mj-class="details">
        <mj-table css-class="details-table">
          <tr><td>Service</td><td>{{ $subscriptionName }}</td></tr>
          <tr><td>Groupe</td><td>{{ $groupName }}</td></tr>
          <tr><td>Montant prévu</td><td>{{ $amount }} $ CAD</td></tr>
          <tr><td>Renouvellement</td><td>{{ $renewalDate }}</td></tr>
        </mj-table>
      </mj-column></mj-section>
      <mj-section css-class="email-section"><mj-column>
<mj-text font-size="14px">Le prélèvement est prévu le {{ $renewalDate }}. Si vous souhaitez annuler, faites-le avant cette date depuis votre espace.</mj-text>        <mj-button href="{{ $dashboardUrl }}">Gérer mon abonnement</mj-button>
      </mj-column></mj-section>
    </mj-wrapper>
    <mj-include path="./partials/footer.mjml" />
  </mj-body>
</mjml>

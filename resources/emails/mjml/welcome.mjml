<mjml>
  <mj-head>
    <mj-font name="Montserrat" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" />
    <mj-attributes>
      <mj-all font-family="Montserrat, Arial, sans-serif" />
      <mj-text font-size="15px" line-height="1.6" color="#374151" />
    </mj-attributes>
  </mj-head>

  <mj-body background-color="#F9FAFB">

    <!-- Header -->
    <mj-section background-color="#0B1929" padding="24px 32px">
      <mj-column>
        <mj-text font-size="22px" font-weight="700" color="#FFFFFF" align="center">
          Equitab
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Hero -->
    <mj-section background-color="#0B1929" padding="0 32px 48px">
      <mj-column>
        <mj-text font-size="32px" font-weight="700" color="#FFFFFF" align="center" line-height="1.3">
          Bienvenue sur Equitab
        </mj-text>
        <mj-text align="center" color="#94A3B8" padding-top="12px" font-size="16px">
          Bonjour <strong style="color: #10B981;">{{ $userName }}</strong>, votre compte est créé avec succès.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Features -->
    <mj-section background-color="#FFFFFF" padding="40px 32px 24px">
      <mj-column>
        <mj-text font-size="18px" font-weight="700" color="#0B1929" align="center" padding-bottom="24px">
          Tout ce que vous pouvez faire avec Equitab
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#FFFFFF" padding="0 32px 16px">
      <mj-column background-color="#F0FDF4" border-radius="12px" padding="20px">
        <mj-text font-size="15px" font-weight="600" color="#0B1929" padding-top="0">
          Économisez sur vos abonnements
        </mj-text>
        <mj-text font-size="14px" color="#6B7280" padding-top="4px">
          Rejoignez des groupes existants et partagez les frais de Netflix, Spotify, Disney+ et plus encore.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#FFFFFF" padding="0 32px 16px">
      <mj-column background-color="#EFF6FF" border-radius="12px" padding="20px">
        <mj-text font-size="15px" font-weight="600" color="#0B1929" padding-top="0">
          Paiements sécurisés par Stripe
        </mj-text>
        <mj-text font-size="14px" color="#6B7280" padding-top="4px">
          Votre argent ne transite jamais par Equitab.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#FFFFFF" padding="0 32px 32px">
      <mj-column background-color="#FFF7ED" border-radius="12px" padding="20px">
        <mj-text font-size="15px" font-weight="600" color="#0B1929" padding-top="0">
          Partagez vos abonnements
        </mj-text>
        <mj-text font-size="14px" color="#6B7280" padding-top="4px">
          Créez un groupe et invitez des membres pour récupérer une partie de vos frais chaque mois.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Étapes -->
    <mj-section background-color="#FFFFFF" padding="0 32px 24px">
      <mj-column>
        <mj-text font-size="18px" font-weight="700" color="#0B1929" padding-bottom="16px">
          Comment démarrer ?
        </mj-text>
        <mj-table>
          <tr>
            <td style="padding: 8px 0; vertical-align: top;">
              <span style="background: #10B981; color: white; border-radius: 50%; width: 24px; height: 24px; display: inline-block; text-align: center; line-height: 24px; font-size: 12px; font-weight: 700;">1</span>
            </td>
            <td style="padding: 8px 0 8px 12px; color: #374151; font-size: 14px;">
              <strong>Vérifiez votre identité</strong> : requis pour créer un groupe et recevoir des paiements.
            </td>
          </tr>
          <tr>
            <td style="padding: 8px 0; vertical-align: top;">
              <span style="background: #10B981; color: white; border-radius: 50%; width: 24px; height: 24px; display: inline-block; text-align: center; line-height: 24px; font-size: 12px; font-weight: 700;">2</span>
            </td>
            <td style="padding: 8px 0 8px 12px; color: #374151; font-size: 14px;">
              <strong>Explorez les groupes disponibles</strong> : trouvez un abonnement à rejoindre.
            </td>
          </tr>
          <tr>
            <td style="padding: 8px 0; vertical-align: top;">
              <span style="background: #10B981; color: white; border-radius: 50%; width: 24px; height: 24px; display: inline-block; text-align: center; line-height: 24px; font-size: 12px; font-weight: 700;">3</span>
            </td>
            <td style="padding: 8px 0 8px 12px; color: #374151; font-size: 14px;">
              <strong>Payez et accédez</strong> : recevez les identifiants immédiatement après le paiement.
            </td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <!-- CTA -->
    <mj-section background-color="#FFFFFF" padding="0 32px 40px">
      <mj-column>
        <mj-button href="{{ $exploreUrl }}" background-color="#10B981" color="#FFFFFF" font-size="15px" font-weight="600" border-radius="8px" padding="14px 0" inner-padding="14px 48px" width="100%">
          Explorer les abonnements
        </mj-button>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section background-color="#F3F4F6" padding="24px 32px">
      <mj-column>
        <mj-text font-size="12px" color="#9CA3AF" align="center">
          © 2026 Equitab Inc. — Plateforme de partage d'abonnements
        </mj-text>
        <mj-text font-size="12px" color="#9CA3AF" align="center" padding-top="4px">
          Des questions ? <a href="mailto:support@equitab.ca" style="color: #10B981;">support@equitab.ca</a>
        </mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>
